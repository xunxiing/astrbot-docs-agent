# GitHub App
GITHUB_APP_ID=
# 二选一：
# 1) 直接把 PEM 私钥全文粘贴到这里（需要保留换行）
GITHUB_APP_PRIVATE_KEY=
# 2) 或者把私钥保存为文件并提供路径（推荐，配合 docker-compose 的只读挂载）
# GITHUB_APP_PRIVATE_KEY_FILE=/secrets/app.private-key.pem
GITHUB_WEBHOOK_SECRET=

# Repo routing（服务只处理这里指定的“代码仓库”）
# 单仓库：
CODE_REPO=AstrBotDevs/AstrBot
# 多仓库（可选，用逗号分隔）：
# CODE_REPOS=owner1/repo1,owner2/repo2
DOCS_REPO=YourOrg/astrbot-docs

# OpenCode (openai-compatible provider)
OPENCODE_BASE_URL=https://api.xxx.com/v1
MY_API_KEY=
# openai-compatible provider id（随便起一个，默认 my-thirdparty）
OPENCODE_PROVIDER_ID=my-thirdparty
# 你可以只填“模型 ID”（推荐，避免搞错 provider/model 格式）
OPENCODE_MODEL=kimi-k2.5
# 或者你也可以填写完整的 provider/model
# OPENCODE_MODEL=my-thirdparty/kimi-k2.5
# 如果你的 OpenAI-compatible 服务不是标准 /v1 路径，可在这里指定完整的 chat/completions URL
# OPENCODE_API_URL=https://api.xxx.com/v1/chat/completions

# OpenCode 变体：为避免部分 OpenAI-compatible 服务在“thinking”模式下要求 reasoning_content，
# 默认使用 minimal（更稳更省资源）。可选：high/max/minimal 等（取决于 provider 支持）。
OPENCODE_VARIANT=minimal

# Server
# 宿主机端口（对外暴露）
HOST_PORT=8787
# 容器内服务监听端口（一般不用改）
PORT=8787
LOG_LEVEL=info
# 负载保护（建议小 VPS 保持默认）
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=10
JOB_TIMEOUT_SECONDS=900
MAX_PATCH_LINES=1200

# 可选：docker compose 使用的镜像
# IMAGE=xunxiing/astrbot-docs-agent-server:latest
