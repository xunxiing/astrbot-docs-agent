# GitHub App
GITHUB_APP_ID=
# Option A: paste the full PEM private key (keep newlines)
GITHUB_APP_PRIVATE_KEY=
# Option B (recommended with docker-compose): mount the key file and point to it
# GITHUB_APP_PRIVATE_KEY_FILE=/secrets/app.private-key.pem
GITHUB_WEBHOOK_SECRET=

# Optional: GitHub Personal Access Token for API-based operations (fallback for git operations)
GITHUB_TOKEN=

# Repo routing (only PRs from these code repos will trigger jobs)
CODE_REPO=AstrBotDevs/AstrBot
# CODE_REPOS=owner1/repo1,owner2/repo2
DOCS_REPO=AstrBotDevs/AstrBot-docs
# Mention name used in PR comments (without '@')
BOT_MENTION=AstrBot-Doc-Agent

# LLM (LangChain)
# Supported: openai-compatible (default) | gemini
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For OpenAI-compatible APIs (NewAPI/OpenRouter/self-hosted), set the base URL (usually ends with /v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_TEMPERATURE=0.2

# Gemini (if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro
# If you're using a Gemini-compatible proxy, you can override the endpoint:
# GEMINI_BASE_URL=https://your-gemini-proxy.example.com
# API version for Gemini endpoint (default v1beta)
# GEMINI_API_VERSION=v1beta

# Outbound proxy (useful for git clone/push inside Docker in CN networks)
# Set USE_PROXY=false to force-disable all proxy env vars even if HTTP_PROXY is present.
USE_PROXY=true
# Recommended for Docker Desktop on Windows/macOS:
# PROXY_URL=http://host.docker.internal:49858
# NO_PROXY=localhost,127.0.0.1,::1

# Git retry (network flakiness)
# GIT_MAX_RETRIES=3
# GIT_RETRY_BASE_MS=1500
# GIT_RETRY_MAX_MS=15000

# Server
HOST_PORT=8787
PORT=8787
LOG_LEVEL=info
# Debug agent steps/tool calls (can be noisy)
LOG_AGENT=false
# Max webhook payload accepted by express raw parser
WEBHOOK_BODY_LIMIT=10mb

# Load-shedding / safety
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=10
JOB_TIMEOUT_SECONDS=900
MAX_PATCH_LINES=1200
# Limit how much stdout/stderr we keep per subprocess in memory
# PROCESS_MAX_CAPTURE_CHARS=200000

# Optional: docker compose image override
# IMAGE=xunxiing/astrbot-docs-agent-server:latest

# Back-compat (deprecated): these are still accepted as fallbacks
# OPENCODE_BASE_URL=https://api.xxx.com/v1
# OPENCODE_MODEL=my-thirdparty/my-model
# MY_API_KEY=your_api_key
